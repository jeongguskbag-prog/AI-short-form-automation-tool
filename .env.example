# 필수
GEMINI_API_KEY=your_gemini_api_key_here

# 무료 사진 API 키 (선택). Gemini 이미지(결제 필요)를 못 쓸 때 씬에 어울리는 사진을 대신 넣습니다.
# 키가 하나도 없어도 Openverse(키 불필요) 사진을 씁니다.
PEXELS_API_KEY=     # https://www.pexels.com/api/
PIXABAY_API_KEY=    # https://pixabay.com/api/docs/ (가입 후 바로 발급)

# 아이템 찾기(인기 쇼츠 수집)용 YouTube Data API v3 키 (선택). 없으면 아이템 찾기 화면에 설정 안내가 나옵니다.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com 에서 사용 설정 → 사용자 인증 정보 → API 키
YOUTUBE_API_KEY=

# 아이템 찾기 · 쇼핑몰 상품 (선택). README의 '쇼핑몰 상품' 참고
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# PRODUCTS_PATH=data/products.json
# MAX_IMPORT_MB=60               # 상품 사진·영상을 소재로 가져올 때 파일 하나 최대 크기

# 같은 와이파이의 폰에서 접속 (python main.py --phone과 같음). 켜면 API_KEYS가 없을 때 자동으로 만듭니다.
# PHONE_ACCESS=true

# 이 서버를 쓰기 위한 API 키 (쉼표로 여러 개). 비우면 인증 없이 실행되니 외부 공개 시 꼭 설정하세요.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# 영상 링크 서명용 비밀키. 비우면 시작할 때마다 새로 만들어져 재시작 시 기존 링크가 무효가 됩니다.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
URL_SIGNING_SECRET=
# VIDEO_URL_TTL_SEC=3600

# 선택 (기본값)
# LLM_MODEL=gemini-flash-latest
# LLM_FALLBACK_MODEL=gemini-flash-lite-latest
# IMAGE_MODEL=gemini-3.1-flash-image   # 무료 등급은 이미지 한도가 0 → 결제 필요
# STOCK_VIDEO=true               # Pexels·Pixabay 키가 있으면 사진보다 무료 스톡 영상을 먼저 사용
# MAX_STOCK_VIDEO_MB=40
# IMAGE_SOURCES=gemini,pexels,pixabay,openverse   # 이미지를 시도하는 순서
# 올린 영상·사진 (선택)
# MEDIA_DIR=data/uploads
# MAX_UPLOAD_MB=200
# UPLOAD_TTL_HOURS=72

# 유튜브 배포 (선택) — README의 '배포 (유튜브)' 참고
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:8000/oauth/youtube/callback
# STATS_REFRESH_HOURS=6           # 올린 영상의 조회수 등을 받아 오는 간격
# YOUTUBE_DECLARE_SYNTHETIC=true   # 'AI로 만든 콘텐츠' 표시
# TOKEN_ENCRYPTION_KEY=            # 연결 토큰 암호화 키. 비우면 data/accounts.key에 자동 생성

# SNS에 올리기 (선택) — README의 'SNS에 올리기' 참고
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v24.0
THREADS_APP_SECRET=
# THREADS_TEMP_UPLOAD_URL=https://tmpfiles.org/api/v1/upload
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=http://localhost:8000/oauth/tiktok/callback

# 보관함 (완성된 영상 저장)
# PROJECTS_DB_PATH=data/projects.db
# LIBRARY_DIR=data/library
# LIBRARY_TTL_DAYS=30

# 배경음악 (선택)
# BGM_VOLUME=0.25                # 화면에서 따로 고르지 않을 때의 음량
# BGM_DUCKING=true               # 내레이션이 나올 때 음악을 자동으로 줄임

# 광고 표시 문구 (쇼핑 대본). 쿠팡 파트너스가 아니면 쓰는 제휴 프로그램에 맞게 바꾸세요.
# AD_DISCLOSURE=이 게시물은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.
# AD_DISCLOSURE_SPOKEN=이 영상은 쿠팡 파트너스 활동으로 수수료를 받을 수 있어요.
# 타입캐스트 성우 목소리 (선택, 유료). 키와 목소리 ID가 있으면 Edge TTS 대신 씁니다.
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
# TYPECAST_MODEL=ssfm-v30
# TYPECAST_TEMPO=1.1
# TYPECAST_EMOTION=
# SUBTITLE_MODE=word            # word: 읽는 단어 강조 구절 자막 / scene: 씬마다 요약 자막 한 줄
# TTS_VOICE=ko-KR-SunHiNeural
# TTS_RATE=+15%
# OUTPUT_DIR=output
# FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
# MAX_CONCURRENT_JOBS=2
# MAX_CONCURRENT_SCENES=3
# JOB_TTL_HOURS=24
# TRENDS_DB_PATH=data/trends.db
# TRENDS_REFRESH_HOURS=12        # 1회 수집에 YouTube 일일 기본 할당량(10,000)의 약 17% 사용
# TRENDS_REGION=KR
# TRENDS_COMMENT_VIDEOS=10       # 분야마다 성과 상위 몇 개 영상의 공개 댓글을 검색용으로 수집
